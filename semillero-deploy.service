[Unit]
Description=Auto-deploy SEMILLERO desde GitHub
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=fac.ingenieria
Group=fac.ingenieria
WorkingDirectory=/home/fac.ingenieria/thesis-manager/proyectos/SEMILLERO
ExecStart=/home/fac.ingenieria/thesis-manager/proyectos/SEMILLERO/auto-deploy.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/fac.ingenieria/thesis-manager/proyectos/SEMILLERO/deploy.log
StandardError=append:/home/fac.ingenieria/thesis-manager/proyectos/SEMILLERO/deploy.log

[Install]
WantedBy=multi-user.target
